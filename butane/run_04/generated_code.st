XI_2901B_HH_Latch(S1 := XI_2901B_HH_Latch.S1, R := XI_2901B_HH_Ack AND (XI_2901B_Scaled < XI_2901B_HH_SP));
XI_2901B_HH := XI_2901B_HH_Latch.Q1;
XI_2901B_H  := XI_2901B_Scaled >= XI_2901B_H_SP AND XI_2901B_Scaled < XI_2901B_HH_SP;
XI_2901B_L  := XI_2901B_Scaled <= XI_2901B_L_SP AND XI_2901B_Scaled > XI_2901B_LL_SP;
IF XI_2901B_Scaled <= XI_2901B_LL_SP THEN
    XI_2901B_LL_Latch.S1 := TRUE;
ELSIF XI_2901B_Scaled >= (XI_2901B_LL_SP + XI_2901B_Deadband) THEN
    XI_2901B_LL_Latch.S1 := FALSE;
END_IF;
XI_2901B_LL_Latch(S1 := XI_2901B_LL_Latch.S1, R := XI_2901B_LL_Ack AND (XI_2901B_Scaled > XI_2901B_LL_SP));
XI_2901B_LL := XI_2901B_LL_Latch.Q1;

System_Alarm :=
    TI_2909_HH_Latch.Q1 OR TI_2909_LL_Latch.Q1 OR TI_2909_H OR TI_2909_L OR
    TT_2909_HH_Latch.Q1 OR TT_2909_LL_Latch.Q1 OR TT_2909_H OR TT_2909_L OR
    TT_2911_HH_Latch.Q1 OR TT_2911_LL_Latch.Q1 OR TT_2911_H OR TT_2911_L OR
    TT_2917_HH_Latch.Q1 OR TT_2917_LL_Latch.Q1 OR TT_2917_H OR TT_2917_L OR
    TI_2917_HH_Latch.Q1 OR TI_2917_LL_Latch.Q1 OR TI_2917_H OR TI_2917_L OR
    XI_2901A_HH_Latch.Q1 OR XI_2901A_LL_Latch.Q1 OR XI_2901A_H OR XI_2901A_L OR
    XI_2901B_HH_Latch.Q1 OR XI_2901B_LL_Latch.Q1 OR XI_2901B_H OR XI_2901B_L OR
    SAFE_STATE;

END_PROGRAM