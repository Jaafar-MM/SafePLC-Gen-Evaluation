    TT_2911_Integral := TT_2911_Integral + (TT_2911_Ki * TT_2911_Error);
    IF TT_2911_Integral > 100.0 THEN
        TT_2911_Integral := 100.0;
    ELSIF TT_2911_Integral < 0.0 THEN
        TT_2911_Integral := 0.0;
    END_IF;
    TT_2911_Output_Pct := (TT_2911_Kp * TT_2911_Error) + TT_2911_Integral;
    IF TT_2911_Output_Pct > 100.0 THEN
        TT_2911_Output_Pct := 100.0;
    ELSIF TT_2911_Output_Pct < 0.0 THEN
        TT_2911_Output_Pct := 0.0;
    END_IF;
    HY_2903A_Pct := TT_2911_Output_Pct;
    HY_2903B_Pct := TT_2911_Output_Pct;
    KV_2904_Pct  := TT_2911_Output_Pct;
    HY_2903A_Out := REAL_TO_INT(6554.0 + (HY_2903A_Pct / 100.0) * (32767.0 - 6554.0));
    HY_2903B_Out := REAL_TO_INT(6554.0 + (HY_2903B_Pct / 100.0) * (32767.0 - 6554.0));
    KV_2904_Out  := REAL_TO_INT(6554.0 + (KV_2904_Pct  / 100.0) * (32767.0 - 6554.0));
    MCC_A_Out    := PumpA_Run;
    MCC_B_Out    := PumpB_Run;
    PSD_2917_Out := PSD_2917;
ELSE
    HY_2903A_Out     := 6554;
    HY_2903B_Out     := 6554;
    KV_2904_Out      := 6554;
    MCC_A_Out        := FALSE;
    MCC_B_Out        := FALSE;
    PSD_2917_Out     := FALSE;
    TT_2911_Integral := 0.0;
END_IF;

System_Alarm :=
    TI_2909_HH_Latch.Q1  OR TI_2909_LL_Latch.Q1  OR TI_2909_H  OR TI_2909_L  OR
    TT_2909_HH_Latch.Q1  OR TT_2909_LL_Latch.Q1  OR TT_2909_H  OR TT_2909_L  OR
    TT_2911_HH_Latch.Q1  OR TT_2911_LL_Latch.Q1  OR TT_2911_H  OR TT_2911_L  OR
    TT_2917_HH_Latch.Q1  OR TT_2917_LL_Latch.Q1  OR TT_2917_H  OR TT_2917_L  OR
    TI_2917_HH_Latch.Q1  OR TI_2917_LL_Latch.Q1  OR TI_2917_H  OR TI_2917_L  OR
    XI_2901A_HH_Latch.Q1 OR XI_2901A_LL_Latch.Q1 OR XI_2901A_H OR XI_2901A_L OR
    XI_2901B_HH_Latch.Q1 OR XI_2901B_LL_Latch.Q1 OR XI_2901B_H OR XI_2901B_L OR
    LOOP_2901A_TRIP OR LOOP_2901B_TRIP OR LOOP_2917_TRIP OR SAFE_STATE;

END_PROGRAM