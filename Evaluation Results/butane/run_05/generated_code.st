    HY_2903B_Output := (HY_2903B_Kp * HY_2903B_Error) + HY_2903B_Integral;
    IF HY_2903B_Output > 100.0 THEN
        HY_2903B_Output := 100.0;
    ELSIF HY_2903B_Output < 0.0 THEN
        HY_2903B_Output := 0.0;
    END_IF;
    HY_2903B_Out := REAL_TO_INT(6554.0 + (HY_2903B_Output / 100.0) * (32767.0 - 6554.0));
ELSE
    HY_2903A_Out      := 6554;
    HY_2903B_Out      := 6554;
    KV_2904           := FALSE;
    Motor_2901A_Out   := FALSE;
    Motor_2901B_Out   := FALSE;
    MCC_Trip_Out      := TRUE;
    PSD_Trip_Out      := FALSE;
    HY_2903A_Integral := 0.0;
    HY_2903B_Integral := 0.0;
END_IF;

System_Alarm :=
    TI_2909_HH_Latch.Q1  OR TI_2909_LL_Latch.Q1  OR TI_2909_H  OR TI_2909_L  OR
    TT_2909_HH_Latch.Q1  OR TT_2909_LL_Latch.Q1  OR TT_2909_H  OR TT_2909_L  OR
    TT_2911_HH_Latch.Q1  OR TT_2911_LL_Latch.Q1  OR TT_2911_H  OR TT_2911_L  OR
    TT_2917_HH_Latch.Q1  OR TT_2917_LL_Latch.Q1  OR TT_2917_H  OR TT_2917_L  OR
    TI_2917_HH_Latch.Q1  OR TI_2917_LL_Latch.Q1  OR TI_2917_H  OR TI_2917_L  OR
    XI_2901A_HH_Latch.Q1 OR XI_2901A_LL_Latch.Q1 OR XI_2901A_H OR XI_2901A_L OR
    XI_2901B_HH_Latch.Q1 OR XI_2901B_LL_Latch.Q1 OR XI_2901B_H OR XI_2901B_L OR
    SAFE_STATE OR MCC_Trip_Out OR PSD_Trip_Out OR Motor_2901A_Out OR Motor_2901B_Out;

