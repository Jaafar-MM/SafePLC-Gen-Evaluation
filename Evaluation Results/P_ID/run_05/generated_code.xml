        <body>
          <ST>
            <html:p>IF FirstScan THEN
    Fv_3_3040_Out     := 6554;
    Fv_3_3041_Out     := 6554;
    ISA_SV_001        := FALSE;
    ISA_SV_002        := FALSE;
    CV_3040_BLK       := FALSE;
    CV_3041_BLK       := FALSE;
    FIC_3040_Integral := 0.0;
    FIC_3041_Integral := 0.0;
    FirstScan         := FALSE;
    RETURN;
END_IF;

FT_10_Scaled := ((INT_TO_REAL(FT_10_Raw) - 6554.0) / (32767.0 - 6554.0)) * FT_10_EU_Span + FT_10_EU_Min;
FT_11_Scaled := ((INT_TO_REAL(FT_11_Raw) - 6554.0) / (32767.0 - 6554.0)) * FT_11_EU_Span + FT_11_EU_Min;

FT_10_HH_Latch(S1 := FT_10_Scaled &gt;= FT_10_HH_SP,
               R  := FT_10_HH_Ack AND (FT_10_Scaled &lt;= (FT_10_HH_SP - FT_10_Deadband)));

IF FT_10_Scaled &gt;= FT_10_H_SP THEN
    FT_10_H := TRUE;
ELSIF FT_10_Scaled &lt;= (FT_10_H_SP - FT_10_Deadband) THEN
    FT_10_H := FALSE;
END_IF;

IF FT_10_Scaled &lt;= FT_10_L_SP THEN
    FT_10_L := TRUE;
ELSIF FT_10_Scaled &gt;= (FT_10_L_SP + FT_10_Deadband) THEN
    FT_10_L := FALSE;
END_IF;

FT_10_LL_Latch(S1 := FT_10_Scaled &lt;= FT_10_LL_SP,
               R  := FT_10_LL_Ack AND (FT_10_Scaled &gt;= (FT_10_LL_SP + FT_10_Deadband)));

FT_11_HH_Latch(S1 := FT_11_Scaled &gt;= FT_11_HH_SP,
               R  := FT_11_HH_Ack AND (FT_11_Scaled &lt;= (FT_11_HH_SP - FT_11_Deadband)));

IF FT_11_Scaled &gt;= FT_11_H_SP THEN
    FT_11_H := TRUE;
ELSIF FT_11_Scaled &lt;= (FT_11_H_SP - FT_11_Deadband) THEN
    FT_11_H := FALSE;
END_IF;

IF FT_11_Scaled &lt;= FT_11_L_SP THEN
    FT_11_L := TRUE;
ELSIF FT_11_Scaled &gt;= (FT_11_L_SP + FT_11_Deadband) THEN
    FT_11_L := FALSE;
END_IF;

FT_11_LL_Latch(S1 := FT_11_Scaled &lt;= FT_11_LL_SP,
               R  := FT_11_LL_Ack AND (FT_11_Scaled &gt;= (FT_11_LL_SP + FT_11_Deadband)));

FIC_3040_Error    := FIC_3040_SP - FT_10_Scaled;
FIC_3040_Integral := FIC_3040_Integral + (FIC_3040_Ki * FIC_3040_Error);
IF FIC_3040_Integral &gt; 100.0 THEN
    FIC_3040_Integral := 100.0;
ELSIF FIC_3040_Integral &lt; 0.0 THEN
    FIC_3040_Integral := 0.0;
END_IF;
FIC_3040_Output := (FIC_3040_Kp * FIC_3040_Error) + FIC_3040_Integral;
IF FIC_3040_Output &gt; 100.0 THEN
    FIC_3040_Output := 100.0;
ELSIF FIC_3040_Output &lt; 0.0 THEN
    FIC_3040_Output := 0.0;
END_IF;
Fv_3_3040_Out := REAL_TO_INT(6554.0 + (FIC_3040_Output / 100.0) * (32767.0 - 6554.0));

FIC_3041_Error    := FIC_3041_SP - FT_11_Scaled;
FIC_3041_Integral := FIC_3041_Integral + (FIC_3041_Ki * FIC_3041_Error);
IF FIC_3041_Integral &gt; 100.0 THEN
    FIC_3041_Integral := 100.0;
ELSIF FIC_3041_Integral &lt; 0.0 THEN
    FIC_3041_Integral := 0.0;
END_IF;
FIC_3041_Output := (FIC_3041_Kp * FIC_3041_Error) + FIC_3041_Integral;
IF FIC_3041_Output &gt; 100.0 THEN
    FIC_3041_Output := 100.0;
ELSIF FIC_3041_Output &lt; 0.0 THEN
    FIC_3041_Output := 0.0;
END_IF;
Fv_3_3041_Out := REAL_TO_INT(6554.0 + (FIC_3041_Output / 100.0) * (32767.0 - 6554.0));

CV_3040_BLK := NOT FT_10_HH_Latch.Q1 AND NOT FT_10_LL_Latch.Q1;
CV_3041_BLK := NOT FT_11_HH_Latch.Q1 AND NOT FT_11_LL_Latch.Q1;
ISA_SV_001  := CV_3040_BLK;
ISA_SV_002  := CV_3041_BLK;

System_Alarm :=
    FT_10_HH_Latch.Q1 OR FT_10_LL_Latch.Q1 OR FT_10_H OR FT_10_L OR
    FT_11_HH_Latch.Q1 OR FT_11_LL_Latch.Q1 OR FT_11_H OR FT_11_L;</html:p>
